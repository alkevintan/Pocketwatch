<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/code_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/mobile_on_surface" />

        <TextView
            android:id="@+id/code_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/mobile_on_surface_secondary" />

        <TextView
            android:id="@+id/code_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="@drawable/mobile_sheet_bg"
            android:textIsSelectable="true"
            android:letterSpacing="0.2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/mobile_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/code_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/mobile_copy_code" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/code_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/mobile_open_link" />
    </LinearLayout>
</ScrollView>
